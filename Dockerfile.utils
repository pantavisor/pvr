ARG PVR_IMAGE=ghcr.io/pantavisor/pvr:develop
FROM ${PVR_IMAGE} AS pvr

FROM alpine:3.18

ARG TARGETARCH
COPY --from=pvr /pkg/bin/linux_${TARGETARCH}/pvr /usr/local/bin/pvr

RUN apk update && apk add --no-cache jq cryptsetup make git curl squashfs-tools fakeroot && rm -rf /var/cache/apk/*

RUN pvr sig download
