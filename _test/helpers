#!/bin/sh

set -e

cmd=$0
dir=$(sh -c "cd $(dirname $cmd); pwd")

[ -d $dir/results ] || mkdir -p $dir/results

pvr="$dir/pvr"

# The initial state tarball is 100 MB, too big for git; it is a release asset.
TEST_DATA_URL="https://github.com/pantavisor/pvr/releases/download/test-data/initial_state_01.tar.gz"
TEST_DATA_SHA256="1a2fee45662524a1ee2cd34d3c4665d663f871e6c1f019ebacba340ec720f034"

fetch_test_data() {
    f="$dir/mocks/data/initial_state_01.tar.gz"
    if [ -f "$f" ] && [ "$(sha256sum "$f" | cut -d' ' -f1)" = "$TEST_DATA_SHA256" ]; then
        return 0
    fi
    echo "downloading test data from $TEST_DATA_URL" >&2
    rm -f "$f"
    if command -v curl >/dev/null 2>&1; then
        curl -fsSL -o "$f" "$TEST_DATA_URL"
    else
        wget -q -O "$f" "$TEST_DATA_URL"
    fi
    if [ "$(sha256sum "$f" | cut -d' ' -f1)" != "$TEST_DATA_SHA256" ]; then
        echo "checksum mismatch for $f" >&2
        rm -f "$f"
        exit 1
    fi
}

fetch_test_data

clean_results() {
    rm -rf $dir/results/* >/dev/null 2>&1
    rm -rf $dir/results/.pv >/dev/null 2>&1
    rm -rf $dir/results/.pvr >/dev/null 2>&1
    rm -rf $dir/objects/ >/dev/null 2>&1
}

# assert_compact_json <message> <file>
# Asserts the json file is compact: byte-identical to its own jq -c form
# (no indentation, no spacing around separators).
assert_compact_json() {
    local message="$1"
    local file="$2"
    local content
    content="$(cat "$file")"
    assertEquals "$message" "$(printf %s "$content" | jq -c .)" "$content"
}

# Docker image caching: pre-cache images locally to avoid Docker Hub rate limits
DOCKER_CACHE_DIR="$dir/docker-cache"

# ensure_docker_image pulls and caches docker images
# Usage: ensure_docker_image <image> [platform]
# If platform is specified, pulls that platform variant specifically
ensure_docker_image() {
    local image="$1"
    local platform="${2:-}"
    local cache_key="$image"
    if [ -n "$platform" ]; then
        cache_key="${image}__${platform}"
    fi
    local cache_file="$DOCKER_CACHE_DIR/$(echo "$cache_key" | tr '/:' '__').tar"

    if [ -n "$platform" ]; then
        # For platform-specific requests, verify the tag points to the correct platform.
        # Docker 28+ with containerd store may store a multi-arch index under the tag
        # (Architecture="" in inspect) when multiple platforms were pulled. In that case
        # daemon.Image()/docker-save can't export the image, so we must rmi and re-pull
        # to get a single-platform tag.
        local arch
        arch=$(docker image inspect "$image" --format '{{.Architecture}}' 2>/dev/null) || arch=""
        local wanted_arch
        wanted_arch=$(echo "$platform" | cut -d/ -f2)
        if [ "$arch" = "$wanted_arch" ]; then
            return 0
        fi
        if [ -n "$arch" ] || docker image inspect "$image" >/dev/null 2>&1; then
            # Tag exists but points to wrong arch or multi-arch index (empty arch).
            # Remove it so the subsequent pull creates a single-platform tag.
            docker rmi "$image" >/dev/null 2>&1 || true
        fi
    else
        if docker image inspect "$image" >/dev/null 2>&1; then
            return 0
        fi
    fi

    # Try to load from cache
    if [ -f "$cache_file" ] && [ -s "$cache_file" ]; then
        if docker load <"$cache_file" >/dev/null 2>&1; then
            return 0
        fi
    fi

    # Pull the image
    rm -f "$cache_file"
    local pull_args=""
    if [ -n "$platform" ]; then
        pull_args="--platform $platform"
    fi
    if ! docker pull $pull_args "$image" 2>&1; then
        echo "WARNING: failed to pull $image" >&2
        return 1
    fi

    # Save to cache
    mkdir -p "$DOCKER_CACHE_DIR"
    if ! docker save "$image" >"$cache_file" 2>&1; then
        rm -f "$cache_file"
        echo "WARNING: failed to save $image to cache" >&2
    fi
}

# Use local docker daemon by default to avoid Docker Hub rate limits.
# Tests that need remote access explicitly pass --source remote.
# In CI environments (GitLab CI, etc.), use remote by default since DinD
# doesn't provide access to all layer blobs for local export.
if [ -n "${CI:-}" ] || [ -n "${GITLAB_CI:-}" ]; then
    export PVR_SOURCE=remote
else
    export PVR_SOURCE=local
fi

# Detect host platform in Docker format (linux/amd64 or linux/arm64)
case "$(uname -m)" in
x86_64)
    HOST_PLATFORM="linux/amd64"
    OTHER_PLATFORM="linux/arm64"
    ;;
aarch64)
    HOST_PLATFORM="linux/arm64"
    OTHER_PLATFORM="linux/amd64"
    ;;
*)
    HOST_PLATFORM="linux/$(uname -m)"
    OTHER_PLATFORM="linux/amd64"
    ;;
esac
