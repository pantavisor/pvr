#!/bin/sh

set -e

cmd=$0
dir=$(sh -c "cd $(dirname $cmd); pwd")

[ -d $dir/results ] || mkdir -p $dir/results

pvr="$dir/pvr"

clean_results() {
  rm -rf $dir/results/* > /dev/null 2>&1
  rm -rf $dir/results/.pv > /dev/null 2>&1
  rm -rf $dir/results/.pvr > /dev/null 2>&1
  rm -rf $dir/objects/ > /dev/null 2>&1
}
