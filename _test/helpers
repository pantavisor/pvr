#!/bin/sh

set -e

cmd=$0
dir=$(sh -c "cd $(dirname $cmd); pwd")

[ -d $dir/results ] || mkdir -p $dir/results

pvr="$dir/pvr"

clean_results() {
  rm -rf $dir/results/* > /dev/null 2>&1
  rm -rf $dir/results/.pv > /dev/null 2>&1
  rm -rf $dir/results/.pvr > /dev/null 2>&1
  rm -rf $dir/objects/ > /dev/null 2>&1
}

# Docker image caching: pre-cache images locally to avoid Docker Hub rate limits
DOCKER_CACHE_DIR="$dir/docker-cache"

# ensure_docker_image pulls and caches docker images
# Usage: ensure_docker_image <image> [platform]
# If platform is specified, pulls that platform variant specifically
ensure_docker_image() {
    local image="$1"
    local platform="${2:-}"
    local cache_key="$image"
    if [ -n "$platform" ]; then
        cache_key="${image}__${platform}"
    fi
    local cache_file="$DOCKER_CACHE_DIR/$(echo "$cache_key" | tr '/:' '__').tar"
    
    # Check if image exists locally (with platform-specific inspect if needed)
    if [ -n "$platform" ]; then
        if docker manifest inspect "$image" --verbose 2>/dev/null | grep -q "\"architecture\": \"$(echo "$platform" | cut -d/ -f2)\""; then
            return 0
        fi
    fi
    if docker image inspect "$image" >/dev/null 2>&1; then
        return 0
    fi
    
    # Try to load from cache
    if [ -f "$cache_file" ] && [ -s "$cache_file" ]; then
        if docker load < "$cache_file" >/dev/null 2>&1; then
            return 0
        fi
    fi
    
    # Pull the image
    rm -f "$cache_file"
    local pull_args=""
    if [ -n "$platform" ]; then
        pull_args="--platform $platform"
    fi
    if ! docker pull $pull_args "$image" 2>&1; then
        echo "WARNING: failed to pull $image" >&2
        return 1
    fi
    
    # Save to cache
    mkdir -p "$DOCKER_CACHE_DIR"
    if ! docker save "$image" > "$cache_file" 2>&1; then
        rm -f "$cache_file"
        echo "WARNING: failed to save $image to cache" >&2
    fi
}

# Use local docker daemon by default to avoid Docker Hub rate limits.
# Tests that need remote access explicitly pass --source remote.
export PVR_SOURCE=local

# Detect host platform in Docker format (linux/amd64 or linux/arm64)
case "$(uname -m)" in
    x86_64)  HOST_PLATFORM="linux/amd64"; OTHER_PLATFORM="linux/arm64" ;;
    aarch64) HOST_PLATFORM="linux/arm64"; OTHER_PLATFORM="linux/amd64" ;;
    *)       HOST_PLATFORM="linux/$(uname -m)"; OTHER_PLATFORM="linux/amd64" ;;
esac
